# Coolify: absolute path inside this site's dedicated persistent volume.
# The database must be restored before the application starts.
STUDIO_DATABASE_PATH=/app/data/studio-gq.db
APP_ORIGIN=https://www.studiogq.co.za
EMAIL_DELIVERY_DISABLED=0
MIGRATION_READ_ONLY=0

# Legacy Vercel / migration source only. Omit both on Coolify.
TURSO_DATABASE_URL=libsql://your-database-your-organisation.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# One shared Studio GQ crew portal identity. These values stay server-only.
CREW_PORTAL_EMAIL=bookings@studiogq.co.za
CREW_PORTAL_PASSWORD=choose-a-long-shared-crew-password
CREW_SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters

# Private server-to-server bridge for Forjdeck. Use the same high-entropy
# secret in Forjdeck's STUDIO_GQ_INTEGRATION_SECRET. The organization id must
# exactly match Forjdeck's STUDIO_GQ_FORJDECK_ORGANIZATION_ID.
FORJDECK_INTEGRATION_SECRET=generate-a-random-secret-of-at-least-32-characters
FORJDECK_ALLOWED_ORGANIZATION_ID=your-forjdeck-organization-id

# Internal booking notification. Configure Resend and verify the sending domain
# before setting BOOKING_FROM_EMAIL in Vercel.
RESEND_API_KEY=re_your-resend-key
BOOKING_FROM_EMAIL=Studio GQ <web@rooiko.com>
BOOKING_NOTIFICATION_EMAIL=bookings@studiogq.co.za
